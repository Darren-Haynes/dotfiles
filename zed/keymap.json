// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // STANDARD MOVE BETWEEN SPLITS / PANES VIM BINDINGS //
  // ------------------------------------------------  //
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "Debugger",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-h": "workspace::ActivatePaneLeft"
    },
  },
  {
    "context": "(GitPanel && ChangesList)",
    "bindings": {
      "ctrl-l": "git_panel::FocusEditor"
    },
  },

  // VIM STANDARDS //
  // ------------- //
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // Better Escape (jj and jk to exit Insert Mode)
      "j j": "vim::NormalBefore",
      "j k": "vim::NormalBefore",
      "k j": "vim::NormalBefore"
    }
  },

  // DEBUGGING //
  //-----------//
  {
    "bindings": {
      "ctrl-cmd-enter": "debugger::Start",
      "ctrl-cmd-j": "debugger::StepOver",
      "ctrl-d space": "debugger::ClearAllBreakpoints",
      "ctrl-cmd-e": "debugger::Stop",
      "ctrl-cmd-i": "debugger::StepInto",
      "ctrl-cmd-o": "debugger::StepOut",
      "ctrl-cmd-x": "debugger::RerunSession",
      "ctrl-cmd-shift-enter": "debugger::Restart",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-r": "debugger::Rerun",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-d b": "editor::ToggleBreakpoint",
    },
  },
  {
    "context": "(Workspace && debugger_stopped)",
    "bindings": {
      "ctrl-cmd-k": "debugger::Continue",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting",
    "bindings": {
      // Start, Pause, Restart, Run-To, Stop
      "space d c": "debugger::Start",
      "space d p": "debugger::Pause",
      "space d r": "debugger::Restart",
      "space d s": "debugger::RunToCursor",
      "space d q": "debugger::Stop",
      "space d Q": "workspace::ShutdownDebugAdapters",

      // Breakpoint Mechanics
      "space d b": "editor::ToggleBreakpoint",
      "space d B": "debugger::ClearAllBreakpoints",

      // Step Sequences
      "space d j": "debugger::StepOver",
      "space d i": "debugger::StepInto",
      "space d o": "debugger::StepOut",
       // Toggle the entire Debugger UI Layout simultaneously (Variables & Console Panels)
      "space d u": "debug_panel::ToggleFocus"
      }
  },

  // AI MANAGEMENT //
  // _________ //
  {
    "bindings": {
      "ctrl-shift-a": "agent::Toggle",
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-a": "agent::Toggle",
      "space a": "workspace::ToggleRightDock"
    }
  },

  // RUN FILES //
  // _________ //
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-r": ["task::Spawn", { "task_name": "Run Python File" }],
      "ctrl-shift-n": ["task::Spawn", { "task_name": "Run JS File" }]
    }
  },

  // TERMINAL //
  // _________ //
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-t": "workspace::NewTerminal",
      "ctrl-shift-l": "pane::ActivateNextItem",
      "ctrl-shift-h": "pane::ActivatePreviousItem"
    }
  },

  // PROJECTS //
  // _________ //
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-o": [
        "projects::OpenRecent",
        {
          "create_new_window": false,
        },
      ],
    },
  },

  // GIT GIT GIT //
  // _________ //
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && Editor && Terminal && DebugConsole",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
    },
  },

  // FILE EXPLORER //
  // _________ //
  {
    "context": "Workspace",
    "bindings": {
      "space e": "project_panel::ToggleFocus",
      "space l a": "editor::ToggleCodeActions",
      "space l r": "editor::Rename",
      "space l f": "editor::Format"
    }
  },

  // LSP MAPPINGS //
  // _________ //
  {
    "context": "Workspace",
    "bindings": {
      "space l a": "editor::ToggleCodeActions",
      "space l r": "editor::Rename",
      "space l f": "editor::Format"
    }
  },
]
