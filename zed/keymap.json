// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // STANDARD MOVE BETWEEN SPLITS / PANES VIM BINDINGS //
  // ------------------------------------------------  //
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "Debugger",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-h": "workspace::ActivatePaneLeft"
    },
  },
  {
    "context": "(GitPanel && ChangesList)",
    "bindings": {
      "ctrl-l": "git_panel::FocusEditor"
    },
  },

  // DEBUGGING //
  //-----------//
  {
    "bindings": {
      "ctrl-cmd-enter": "debugger::Start",
      "ctrl-cmd-j": "debugger::StepOver",
      "ctrl-d space": "debugger::ClearAllBreakpoints",
      "ctrl-cmd-e": "debugger::Stop",
      "ctrl-cmd-i": "debugger::StepInto",
      "ctrl-cmd-o": "debugger::StepOut",
      "ctrl-cmd-x": "debugger::RerunSession",
      "ctrl-cmd-shift-enter": "debugger::Restart",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-r": "debugger::Rerun",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-d b": "editor::ToggleBreakpoint",
    },
  },
  {
    "context": "(Workspace && debugger_stopped)",
    "bindings": {
      "ctrl-cmd-k": "debugger::Continue",
    },
  },
  // AI MANAGEMENT //
  // _________ //
  {
    "bindings": {
      "ctrl-shift-a": "agent::Toggle",
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-a": "agent::Toggle",
    }
  },

  // RUN FILES //
  // _________ //
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-r": ["task::Spawn", { "task_name": "Run Python File" }],
      "ctrl-shift-n": ["task::Spawn", { "task_name": "Run JS File" }]
    }
  },

  // TERMINAL //
  // _________ //
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-t": "workspace::NewTerminal",
      "ctrl-shift-l": "pane::ActivateNextItem",
      "ctrl-shift-h": "pane::ActivatePreviousItem"
    }
  },

  // PROJECTS //
  // _________ //
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-o": [
        "projects::OpenRecent",
        {
          "create_new_window": false,
        },
      ],
    },
  },

  // GIT GIT GIT //
  // _________ //
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && Editor && Terminal && DebugConsole",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
    },
  },
  {
    "bindings": {
      "ctrl-g u": "git::ViewUnstagedChanges"
    }
  },
  {
    "bindings": {
      "ctrl-g s": "git::ViewStagedChanges"
    }
  },
  {
    "bindings": {
      "ctrl-g c": "git::ViewCommit"
    }
  },
  {
    "bindings": {
      "ctrl-g f": "git::ViewFile"
    }
  },
  {
    "bindings": {
      "ctrl-g g": "git_graph::OpenCommitView"
    }
  }
]
