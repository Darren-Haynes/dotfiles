{
  "markdown_preview_font_size": 16.0,
  "agent_ui_font_family": "JetBrainsMono Nerd Font Mono",
  "active_pane_modifiers": {
    "border_size": 0.0
  },
  "centered_layout": {
    "right_padding": 0.0,
    "left_padding": 0.0
  },
  "ui_font_weight": 400.0,
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "agent_buffer_font_size": 15.0,
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "agent_ui_font_size": 16.0,
  "buffer_line_height": "standard",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "terminal": {
    "shell": {
      "program": "zsh",
    },
    "font_weight": 395.0,
    "toolbar": {
      "breadcrumbs": false,
    },
    "font_family": "Fira Code",
    "font_size": 15.0,
    "font_fallbacks": ["Noto Color Emoji"]
  },
  "base_keymap": "VSCode",
  "status_bar": {
    "experimental.show": false,
  },
  "tab_bar": {
    "show": false,
  },
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_user_menu": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "scrollbar": {
    "axes": {
      "vertical": false,
    },
  },
  "buffer_font_fallbacks": ["Menlo", "Monaco", "Courier New", "monospace", "Noto Color Emoji"],
  "buffer_font_family": "Fira Code",
  "linked_edits": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 15.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Oceanic Next Light",
    "dark": "Base16 Zenburn" // THEME_SWITCHER_DARK
  },
  "which_key": { "enabled": true },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "auto_fold_dirs": false,
    "sticky_scroll": false,
    "default_width": 400,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 400,
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
  },
  "file_types": {
    "Shell Script": ["alias", "aliases"],
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "auto_discover": true
    }
  },
  "agent": {
    "play_sound_when_agent_done": "when_hidden",
    "sidebar_side": "right",
    "dock": "right",
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "provider": "google",
      "model": "gemini-3.6-flash"
    }
  },
  "edit_predictions": {
    "provider": "zed",
    "ollama": {
      "model": "qwen2.5-coder:14b",
      "prompt_format": "infer"
    }
  }
}
