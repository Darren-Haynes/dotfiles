# ==============================================================================
# M1 iMac Thin-Client Display Automation & Structural Architecture
# ==============================================================================

## Core Variables & Token Mapping
set $mod          Mod4
set $hyper        Ctrl+Mod1+Mod4
set $hyper_shift  Ctrl+Mod1+Mod4+Shift

set $left         h
set $down         j
set $up           k
set $right        l

set $term         foot
set $lock         swaylock -f

# Application Launcher Matrix
set $rofi_cmd     rofi -terminal '$term' -theme bubblegum
set $menu         $rofi_cmd -show combi -combi-modes drun#run -modes combi

# Workspace Domain Assignments
set $ws1          "1: "
set $ws2          "2: "
set $ws3          "3: "
set $ws4          "4: "
set $ws5          "5: "
set $ws6          "6"
set $ws7          "7"
set $ws8          "8"
set $ws9          "9: "
set $ws10         "10"

# ==============================================================================
# Compositor Pipeline, Boot Initialization & Daemon Orchestration
# ==============================================================================

# Headless Canvas Target Engine
exec_always "swaymsg -t get_outputs -r | grep -q HEADLESS-1 || swaymsg create_output HEADLESS-1; swaymsg output HEADLESS-1 mode 2240x1260 position 0 0 scale 1"

# Environment Variables & Core Session Pipeline
exec "systemctl --user import-environment {,WAYLAND_}DISPLAY SWAYSOCK; systemctl --user start sway-session.target"
exec swaymsg -t subscribe '["shutdown"]' && systemctl --user stop sway-session.target

# UI Daemons & Clipboard Sync Matrix
exec_always "pkill waybar; ~/Dotfiles/sway/waybar-accent.sh; waybar"
exec_always ~/Dotfiles/sway/wallpaper-picker.sh --restore
bindsym Ctrl+Mod1+Mod4+Return exec killall -q -SIGUSR1 waybar
exec wl-paste --type text  --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Secure Local Headless Connection Core
exec wayvnc --output=HEADLESS-1 127.0.0.1 5900

# Load the SSH key into the session agent once per login (rofi passphrase prompt)
exec ~/Dotfiles/sway/ssh-add-login.sh

# ==============================================================================
# Bubblegum Theme Palette
# ==============================================================================
# Class                  border    backgr.   text      indicator child_border
client.focused          "#3A3A3A" "#3A3A3A" "#ffffff" "#488F6D"   "#3A3A3A"
client.focused_inactive "#454545" "#2A2A2a" "#A7A7A7" "#303030"   "#222222"
client.unfocused        "#303030" "#2A2A2A" "#A7A7A7" "#222222"   "#222222"
client.urgent           "#D78787" "#402020" "#ffffff" "#D78787"   "#D78787"
client.background       "#303030"
# Window border colours follow the accent and dark/light variant: written by
# sway/apply-sway-colors.sh (called from toggle-theme.sh), overriding the
# defaults above. A missing file is ignored.
include ~/.local/state/bubblegum/sway-colors.conf

# GTK + icon bubblegum light/dark theme toggle
bindsym Mod1+Shift+d exec ~/Dotfiles/sway/toggle-theme.sh
# Accent colour picker (pink / blue / green / mono) for the GTK theme, icons and dunst
bindsym Mod1+Shift+a exec ~/Dotfiles/sway/accent-picker.sh

# ==============================================================================
# Precision Wayland Screenshot Engine Matrix (grimshot + cliphist sync)
# ==============================================================================
# 1. Ctrl + Super + a -> Interactive region selection tool
bindsym Ctrl+$mod+a exec grimshot --notify copy area
# 2. Ctrl + Super + s -> Screenshot ONLY the currently active monitor output screen
bindsym Ctrl+$mod+s exec grimshot --notify copy output
# 3. Ctrl + Super + w -> Screenshot ONLY the focused tiling application client window
bindsym Ctrl+$mod+w exec grimshot --notify copy active
bindsym Ctrl+Mod1+Mod4+g exec ~/Dotfiles/bash-scripts/toggle_gaps_sway.sh

# ==============================================================================
# Interactive GUI Screenshot & Save Engine Matrix (grimshot + swappy)
# ==============================================================================
# 1. Super + Mod4 + a -> Snapshot interactive target area and edit
bindsym Ctrl+Shift+$mod+a exec grimshot save area - | swappy -f -
# 2. Super + Mod4 + s -> Snapshot entire active screen output and edit
bindsym Ctrl+Shift+$mod+s exec grimshot save output - | swappy -f -
# 3. Super + Mod4 + w -> Snapshot focused tiling window container and edit
bindsym Ctrl+Shift+$mod+w exec grimshot save active - | swappy -f -
# Automatically format the swappy overlay framework beautifully
for_window [app_id="swappy"] floating enable, resize set width 70 ppt height 75 ppt, move position center
# In sway config
bindsym $mod+Shift+r exec ~/Dotfiles/sway/screen-recorder-toggle.sh
bindsym $mod+Shift+w exec ~/Dotfiles/sway/wallpaper-picker.sh

# ==============================================================================
# Floating Window Positional Macros
# ==============================================================================
bindsym Ctrl+Mod1+Mod4+l floating enable, resize set width 50 ppt height 100 ppt, move position 50 ppt 0 ppt
bindsym Ctrl+Mod1+Mod4+h floating enable, resize set width 50 ppt height 100 ppt, move position 0 ppt 0 ppt
bindsym Ctrl+Mod1+Mod4+j floating enable, resize set width 100 ppt height 50 ppt, move position 0 ppt 50 ppt
bindsym Ctrl+Mod1+Mod4+k floating enable, resize set width 100 ppt height 50 ppt, move position 0 ppt 0 ppt
bindsym Ctrl+Mod1+Mod4+equal floating enable, resize set width 60 ppt height 80 ppt, move position center

# ==============================================================================
# Hardware Output Mapping & Dedicated Application Routing Rules
# ==============================================================================

output HDMI-A-1 disable

# Bind Workspaces Intuitively onto the Headless Canvas
workspace $ws1  output HEADLESS-1
workspace $ws2  output HEADLESS-1
workspace $ws3  output HEADLESS-1
workspace $ws4  output HEADLESS-1
workspace $ws5  output HEADLESS-1
workspace $ws6  output HEADLESS-1
workspace $ws7  output HEADLESS-1
workspace $ws8  output HEADLESS-1
workspace $ws9  output HEADLESS-1
workspace $ws10 output HEADLESS-1

# Declarative Window Capture Matrix
assign [app_id="foot-main"]     $ws1
assign [app_id="brave-browser"] $ws2
assign [app_id="dev.zed.Zed"]    $ws3

# Boot-Time Sequencer Loop
exec foot --app-id="foot-main"
# apply-brave-theme.sh picks the dark/light manifest before Brave reads it.
exec sh -c '~/Dotfiles/sway/apply-brave-theme.sh; exec brave-browser'
exec sleep 5 && /home/darren/.local/bin/zed --foreground

# ==============================================================================
# Global Styling Parameters & Window Behavior Customizations
# ==============================================================================

hide_edge_borders smart
default_border none
default_floating_border pixel 6
titlebar_separator disable

# SwayFX: rounded floating windows, square tiled ones. SwayFX can't set a radius
# per window, but with smart_corner_radius a window is only rounded when it is
# floating or the workspace has gaps. With no gaps (the default; Hyper+g toggles
# them) tiled windows stay square. Gaps on -> tiled windows round too.
# (Plain sway rejects these commands; the install script installs swayfx.)
corner_radius 12
smart_corner_radius enable
focus_follows_mouse no
floating_modifier $mod normal
title_align center

# ==============================================================================
# Dynamic Window Capture Rules & Floating Geometry Resizer Assignments
# ==============================================================================
for_window [app_id="foot"]                    	      border pixel 2
for_window [app_id="floating-viewer"]                 floating enable
for_window [app_id="zenity"]                          floating enable, border pixel 12, move position center
for_window [app_id="xdg-desktop-portal-gtk"]          floating enable, border pixel 12, resize set width 60 ppt height 65 ppt, move position center
for_window [app_id="mpv"]                             floating enable, border pixel 12, move position center
for_window [app_id="ny-sheriff-summer-camp-scheduler"] floating enable, border pixel 4, move position center
for_window [app_id="org.gnome.Characters"]            floating enable, resize set width 65 ppt height 75 ppt, move position center
for_window [app_id="swappy"]                          floating enable, resize set width 70 ppt height 75 ppt, move position center
for_window [app_id="thunar"]                          floating enable, border pixel 12, resize set width 60 ppt height 65 ppt, move position center
for_window [app_id="blueman-manager"]                 floating enable, border pixel 12, resize set width 60 ppt height 65 ppt, move position center
for_window [app_id="org.pulseaudio.pavucontrol"]      floating enable, border pixel 12, resize set width 60 ppt height 65 ppt, move position center
for_window [app_id="com.transmissionbt.transmission"] floating enable, border pixel 12, resize set width 60 ppt height 65 ppt, move position center
for_window [app_id="org.speedcrunch.SpeedCrunch"]     floating enable, border pixel 10 #87d7ff, resize set width 50 ppt height 100 ppt, move position 50 ppt 0 ppt

# Scratchpad System Targets
for_window [app_id="foot-scratchpad"]                 floating enable, move scratchpad
for_window [app_id="foot-yazi"]                       floating enable, move scratchpad
for_window [app_id="foot-demand"]                     floating enable, move scratchpad

# ==============================================================================
# Dynamic Split-Ratio Geometry Resizer Matrix (10% to 90%)
# ==============================================================================
bindsym Ctrl+Mod1+Mod4+1 focus left, resize set width 10 ppt
bindsym Ctrl+Mod1+Mod4+2 focus left, resize set width 20 ppt
bindsym Ctrl+Mod1+Mod4+3 focus left, resize set width 30 ppt
bindsym Ctrl+Mod1+Mod4+4 focus left, resize set width 40 ppt
bindsym Ctrl+Mod1+Mod4+5 focus left, resize set width 50 ppt
bindsym Ctrl+Mod1+Mod4+6 focus left, resize set width 60 ppt
bindsym Ctrl+Mod1+Mod4+7 focus left, resize set width 70 ppt
bindsym Ctrl+Mod1+Mod4+8 focus left, resize set width 80 ppt
bindsym Ctrl+Mod1+Mod4+9 focus left, resize set width 90 ppt

# ==============================================================================
# Layer 1 Keybindings ($mod Cluster): System Structure & Spatial Layouts
# ==============================================================================

# Core System Lifecycles
bindsym $mod+Return   exec ~/Dotfiles/sway/open-terminal.sh
bindsym $mod+Shift+q  kill
bindsym $mod+d        exec $menu
bindsym $mod+Shift+c  reload
bindsym $mod+Shift+e  exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Clipboard & History Tools
bindsym $mod+c        exec cliphist list | rofi -dmenu -p "📋 Clipboard" -theme bubblegum | cliphist decode | wl-copy
bindsym $mod+Mod1+c   exec cliphist list | rofi -dmenu -p "🗑️ Erase Clip" -theme bubblegum | cliphist delete

# Interactive Context Utility Triggers
bindsym $mod+Shift+n  exec foot --app-id="floating-nmtui" -e nmtui
bindsym $mod+Shift+x  exec hyprpicker
bindsym $mod+Shift+t  exec ~/.config/sway/toggle-titlebars.sh
bindsym $mod+Shift+o  exec grim -g "$(slurp)" - | tesseract - - | wl-copy

# Power Infrastructure & Session Lock Loops
exec swayidle -w timeout 1 "idlehint 1" before-sleep "$lock"
bindsym $mod+Escape   exec $lock

# Tiling Toggles & Layout Changes
bindsym $mod+b        splith
bindsym $mod+v        splitv
bindsym $mod+s        layout stacking
bindsym $mod+w        layout tabbed
bindsym $mod+e        layout toggle split
bindsym $mod+Shift+f  fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space    focus mode_toggle
bindsym $mod+a        focus parent

# Interactive Scratchpad Core Infrastructure
bindsym $mod+minus          scratchpad show
bindsym $mod+Shift+minus    move scratchpad

# Main Scratchpad Invocation Triggers
bindsym $mod+Shift+Return   exec swaymsg '[app_id="foot-scratchpad"] scratchpad show, fullscreen enable' || (foot -a foot-scratchpad btop & sleep 0.15 && swaymsg '[app_id="foot-scratchpad"] scratchpad show, fullscreen enable')
bindsym $mod+f              exec swaymsg '[app_id="foot-yazi"] scratchpad show, fullscreen enable' || (foot -a foot-yazi yazi & sleep 0.15 && swaymsg '[app_id="foot-yazi"] scratchpad show, fullscreen enable')
bindsym $mod+t              exec swaymsg '[app_id="foot-demand"] scratchpad show, fullscreen enable' || (foot -a foot-demand & sleep 0.15 && swaymsg '[app_id="foot-demand"] scratchpad show, fullscreen enable')

# Unified Dynamic Pair Focus
bindsym $mod+Shift+z exec $HOME/.config/sway/sway-dynamic-pair.sh
bindsym Ctrl+Mod1+Mod4+z exec $HOME/.config/sway/zed-brave-split.sh
bindsym Ctrl+Mod1+Mod4+a exec $HOME/.config/sway/foot-brave-split.sh
bindsym Ctrl+Mod1+Mod4+t exec $HOME/.config/sway/foot-zed-split.sh
bindsym Ctrl+Mod1+Mod4+s exec $HOME/.config/sway/sway-swap-split.sh

# Spatial Focus Navigation Vector (Vim Home Row + Arrow Fallback Keys)
bindsym $mod+$left          focus left
bindsym $mod+$down          focus down
bindsym $mod+$up            focus up
bindsym $mod+$right         focus right
bindsym $mod+Left           focus left
bindsym $mod+Down           focus down
bindsym $mod+Up             focus up
bindsym $mod+Right          focus right

# Window Container Relocation Engine
bindsym $mod+Shift+$left    move left
bindsym $mod+Shift+$down    move down
bindsym $mod+Shift+$up      move up
bindsym $mod+Shift+$right   move right
bindsym $mod+Shift+Left     move left
bindsym $mod+Shift+Down     move down
bindsym $mod+Shift+Up       move up
bindsym $mod+Shift+Right    move right

# Workspace Jump Mapping
bindsym $mod+1              workspace number $ws1
bindsym $mod+2              workspace number $ws2
bindsym $mod+3              workspace number $ws3
bindsym $mod+4              workspace number $ws4
bindsym $mod+5              workspace number $ws5
bindsym $mod+6              workspace number $ws6
bindsym $mod+7              workspace number $ws7
bindsym $mod+8              workspace number $ws8
bindsym $mod+9              workspace number $ws9
bindsym $mod+0              workspace number $ws10

# Workspace Window Migration Matrix
bindsym $mod+Shift+1        move container to workspace number $ws1
bindsym $mod+Shift+2        move container to workspace number $ws2
bindsym $mod+Shift+3        move container to workspace number $ws3
bindsym $mod+Shift+4        move container to workspace number $ws4
bindsym $mod+Shift+5        move container to workspace number $ws5
bindsym $mod+Shift+6        move container to workspace number $ws6
bindsym $mod+Shift+7        move container to workspace number $ws7
bindsym $mod+Shift+8        move container to workspace number $ws8
bindsym $mod+Shift+9        move container to workspace number $ws9
bindsym $mod+Shift+0        move container to workspace number $ws10

# Manual Sizing Adjustments (Resize Mode)
mode "resize" {
    bindsym $left           resize shrink width 10px
    bindsym $down           resize grow height 10px
    bindsym $up             resize shrink height 10px
    bindsym $right          resize grow width 10px
    bindsym Return          mode "default"
    bindsym Escape          mode "default"
}
bindsym $mod+r              mode "resize"
bindsym $mod+Page_Up        resize grow width 10px, resize grow height 10px

# Ensure systemd user services know where to look for themes and icons
exec ~/Dotfiles/sway/gtk-theme-env.sh
exec systemctl --user set-environment XDG_DATA_DIRS="$HOME/.local/share:$HOME/.themes:/usr/local/share:/usr/share"

# Import environment variables into dbus/systemd
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP GTK_THEME
