# ==============================================================================
# M1 iMac Thin-Client Display Automation
# ==============================================================================

### Variables
#
# 0. Modifier key used by bindsym below (Mod4 = Super/Windows key)
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher
set $rofi_cmd rofi \
        -terminal '$term' \
        -theme bubblegum
# Shows a combined list of the applications with desktop files and executables from PATH.
set $menu $rofi_cmd -show combi -combi-modes drun#run -modes combi

# ==============================================================================
# Custom Output / Session Setup
# ==============================================================================

# 1. Define Named Workspace Variables (All 10 slots safely declared)
set $ws1 "1: "
set $ws2 "2: "
set $ws3 "3: "
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# 2. Generate the perfect pixel-mapped 16:9 canvas on boot
exec_always "swaymsg -t get_outputs -r | grep -q HEADLESS-1 || swaymsg create_output HEADLESS-1; swaymsg output HEADLESS-1 mode 2240x1260 position 0 0 scale 1"

# 1b. Set the wallpaper
exec_always "pkill -x swaybg; swaybg -i ~/Pictures/Wallpaper/oceanic.jpg -m fill"

# 3. Bind your main development spaces to this crisp layout view
output HDMI-A-1 disable
workspace $ws1 output HEADLESS-1
workspace $ws2 output HEADLESS-1
workspace $ws3 output HEADLESS-1
workspace $ws4 output HEADLESS-1
workspace $ws5 output HEADLESS-1
workspace $ws6 output HEADLESS-1
workspace $ws7 output HEADLESS-1
workspace $ws8 output HEADLESS-1
workspace $ws9 output HEADLESS-1
workspace $ws10 output HEADLESS-1

# 4. Assign Applications to Specific Named Workspaces
assign [app_id="foot-main"] $ws1
assign [app_id="brave-browser"] $ws2
assign [app_id="zed"] $ws3

# 5. Automatically Boot & Route Your Apps on Login
exec foot --app-id="foot-main"
exec brave-browser
exec sleep 5 && zed

# FIX: Wrapped inside a bash string execution container to cleanly parse both instructions on log-in
exec_always "pkill waybar; waybar"

# Store text and images cleanly into the history database
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# 6. Run the secure internal connection engine (Local Only)
exec wayvnc --output=HEADLESS-1 127.0.0.1 5900

# ==============================================================================
# Window Rules & Management Macros
# ==============================================================================

# ==============================================================================
# Foot + Btop Fullscreen Scratchpad Monitor (Native Focus Routing)
# ==============================================================================
# 1. Catch Foot-Btop on birth, enable its floating canvas, and hide it away first
for_window [app_id="foot-scratchpad"] floating enable, move scratchpad

# 2. Perfect Toggle Loop: Isolated inside brackets so its keys stay bound to Return!
bindsym $mod+Shift+Return exec swaymsg '[app_id="foot-scratchpad"] scratchpad show' || (foot -a foot-scratchpad btop & sleep 0.15 && swaymsg '[app_id="foot-scratchpad"] scratchpad show, fullscreen enable')

# ==============================================================================
# Foot + Yazi Fullscreen File Cockpit (Native Sixel Engine)
# ==============================================================================
# 1. Catch Foot-Yazi on birth, enable its floating canvas, and hide it away first
for_window [app_id="foot-yazi"] floating enable, move scratchpad
for_window [app_id="foot-demand"] floating enable, move scratchpad

# 2. Perfect Toggle Loop: Isolated inside brackets so its keys stay bound to F!
bindsym $mod+Shift+f exec swaymsg '[app_id="foot-yazi"] scratchpad show' || (foot -a foot-yazi yazi & sleep 0.15 && swaymsg '[app_id="foot-yazi"] scratchpad show, fullscreen enable')
bindsym $mod+t exec swaymsg '[app_id="foot-demand"] scratchpad show' || (foot -a foot-demand & sleep 0.15 && swaymsg '[app_id="foot-demand"] scrathcpad show, fullscreen enable')

# Automatically format SpeedCrunch as a right-side sidebar whenever it spawns
for_window [app_id="org.speedcrunch.SpeedCrunch"] floating enable, resize set width 40 ppt height 90 ppt, move position 60 ppt 5 ppt

# ==============================================================================

# App-specific focus shortcuts (Ctrl+Alt+Super + Key)
bindsym Ctrl+Mod1+Mod4+u [app_id="brave-browser"] focus
bindsym Ctrl+Mod1+Mod4+i [app_id="dev.zed.Zed"] focus
bindsym Ctrl+Mod1+Mod4+y [app_id="foot-main"] focus
bindsym Ctrl+Mod1+Mod4+o [app_id="eu.betterbird.Betterbird"] focus
bindsym Ctrl+Mod1+Mod4+c exec speedcrunch
bindsym Ctrl+Mod1+Mod4+p [app_id="org.gnome.Nautilus"] focus

# Split-Screen Focus Warp Mode Toggles

# Unified Dynamic Pair Focus Warp Loop Macro (Super + Shift + z)
bindsym $mod+Shift+z exec $HOME/.config/sway/sway-dynamic-pair.sh
bindsym Ctrl+Mod1+Mod4+z exec $HOME/.config/sway/zed-brave-split.sh
bindsym Ctrl+Mod1+Mod4+a exec $HOME/.config/sway/foot-brave-split.sh
bindsym Ctrl+Mod1+Mod4+t exec $HOME/.config/sway/foot-zed-split.sh
bindsym Ctrl+Mod1+Mod4+s exec $HOME/.config/sway/sway-swap-split.sh

# Toggle your custom hardware monitor scratchpad layout on demand
# bindsym $mod+Shift+Return [app_id="foot-scratchpad"] scratchpad show

# Send a toggle signal to Waybar on Fedora using Ctrl+Alt+Super+Return
bindsym Ctrl+Mod1+Mod4+Return exec killall -q -SIGUSR1 waybar

# Press Mod4 (Super) + c to pop open your searchable clipboard history
bindsym $mod+c exec cliphist list | rofi -dmenu -p "📋 Clipboard" -theme bubblegum | cliphist decode | wl-copy

# Automatically open Gnome Characters in a floating window container
for_window [app_id="org.gnome.Characters"] floating enable, resize set width 65 ppt height 75 ppt, move position center
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set width 65 ppt height 75 ppt, move position center

# Automatically open your Yazi image viewers as high-visibility floating cards
for_window [app_id="floating-viewer"] floating enable


# ==============================================================================
# Styling Parameters & Theme Sync
# ==============================================================================
hide_edge_borders smart
default_border none
default_floating_border pixel 12
titlebar_separator disable

# Press Mod4 (Super) + n to pop open your interactive floating Wi-Fi menu
bindsym $mod+Shift+n exec foot --app-id="floating-nmtui" -e nmtui

# Automatically format specific application triggers on creation
for_window [app_id="floating-nmtui"] floating enable
for_window [app_id="org.gnome.Characters"] floating enable

# FIX: Forcing an explicit border style reset completely strips the GTK application-level overrides!
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, border pixel 12, resize set width 60 ppt height 65 ppt, move position center
for_window [app_id="thunar"] floating enable, border pixel 12, resize set width 60 ppt height 65 ppt, move position center

# Universal Tiling Override (Forces all floating windows to scale, center, and apply borders together)
for_window [floating] border pixel 12, resize set width 60 ppt height 65 ppt, move position center

# Bubblegum Theme Palette (from zed/themes/bubblegum/bubblegum+.json)
# Class                  border    backgr.   text      indicator child_border
client.focused          "#87D7FF" "#3A3A3A" "#ffffff" "#87D7FF"   "#87D7FF"
client.focused_inactive "#454545" "#2A2A2a" "#A7A7A7" "#303030"   "#222222"
client.unfocused        "#303030" "#222222" "#808080" "#222222"   "#222222"
client.urgent           "#D78787" "#402020" "#ffffff" "#D78787"   "#D78787"
client.background       "#303030"

bindsym $mod+Shift+x exec hyprpicker
bindsym $mod+Shift+t exec ~/.config/sway/toggle-titlebars.sh

# ==============================================================================
# Key bindings (ported from Fedora's stock /etc/sway/config)
# ==============================================================================
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    floating_modifier $mod normal

    # Reload the configuration file safely
    bindsym $mod+Shift+c reload

    # Exit sway
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Moving around focus loops:
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

# Layout transitions:
    bindsym $mod+b splith
    bindsym $mod+v splitv
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split
    bindsym $mod+f fullscreen
    bindsym $mod+Shift+space floating toggle
    bindsym $mod+space focus mode_toggle
    bindsym $mod+a focus parent

# Core Scratchpad navigation toggle:
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show

# Resizing containers:
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ==============================================================================
# Workspaces Navigation Matrix (Restored)
# ==============================================================================
