# ==============================================================================
# M1 iMac Thin-Client Display Automation
# ==============================================================================

### Variables
#
# 0. Modifier key used by bindsym below (Mod4 = Super/Windows key)
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term alacritty
# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.

set $rofi_cmd rofi \
        -terminal '$term' \
        -theme bubblegum
# Shows a combined list of the applications with desktop files and
# executables from PATH.
set $menu $rofi_cmd -show combi -combi-modes drun#run -modes combi

# ==============================================================================
# Custom Output / Session Setup
# ==============================================================================

# 1. Define Named Workspace Variables (All 10 slots safely declared)
set $ws1 "1: Term"
set $ws2 "2: Browse"
set $ws3 "3: Zed"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# 2. Generate the perfect pixel-mapped 16:9 canvas on boot (idempotent: only
# creates HEADLESS-1 if it doesn't already exist, so repeated reloads don't
# keep spawning extra duplicate headless outputs, and position is pinned to
# 0,0 so wayvnc/TigerVNC pointer coordinates line up correctly)
exec_always "swaymsg -t get_outputs -r | grep -q HEADLESS-1 || swaymsg create_output HEADLESS-1; swaymsg output HEADLESS-1 mode 2240x1260 position 0 0 scale 1"

# 1b. Set the wallpaper (kept in sync with bash-scripts/theme-switcher.zsh,
# which replaces the running swaybg process when the theme changes)
exec_always "pkill -x swaybg; swaybg -i ~/Pictures/Wallpaper/oceanic.jpg -m fill"

# 1c. Load the SSH key into the session ssh-agent once at startup so git
# push/pull don't prompt for the key passphrase on every invocation.
exec ssh-add -q ~/.ssh/id_ed25519

# 3. Bind your main development spaces to this crisp layout view
output HDMI-A-1 disable
workspace $ws1 output HEADLESS-1
workspace $ws2 output HEADLESS-1
workspace $ws3 output HEADLESS-1
workspace $ws4 output HEADLESS-1
workspace $ws5 output HEADLESS-1
workspace $ws6 output HEADLESS-1
workspace $ws7 output HEADLESS-1
workspace $ws8 output HEADLESS-1
workspace $ws9 output HEADLESS-1
workspace $ws10 output HEADLESS-1

# 4. Assign Applications to Specific Named Workspaces
assign [app_id="Alacritty"] $ws1
assign [app_id="brave-browser"] $ws2
#assign [app_id="dev.zed.Zed"] $ws3

# 5. Automatically Boot & Route Your Apps on Login
exec alacritty -e zellij attach -c "DOTFILES" options --default-cwd "$HOME/Dotfiles"
exec brave-browser
exec "sleep 5 && zed"
exec "sleep 1 && env SWAYSOCK=$(ls /run/user/1000/sway-ipc.1000.*.sock | head -n 1) waybar"

# Store text and images cleanly into the history database
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# 6. Run the secure internal connection engine (Local Only)
exec wayvnc --output=HEADLESS-1 127.0.0.1 5900

# App-specific focus shortcuts (Ctrl+Alt+Super + Key)
bindsym Ctrl+Mod1+Mod4+u [app_id="brave-browser"] focus
bindsym Ctrl+Mod1+Mod4+i [app_id="dev.zed.Zed"] focus
bindsym Ctrl+Mod1+Mod4+y [app_id="Alacritty"] focus
bindsym Ctrl+Mod1+Mod4+o [app_id="eu.betterbird.Betterbird"] focus
bindsym Ctrl+Mod1+Mod4+c exec speedcrunch
bindsym Ctrl+Mod1+Mod4+p [app_id="org.gnome.Nautilus"] focus

# Split-Screen Focus Warp Mode Toggle
bindsym Ctrl+Mod1+Mod4+z exec $HOME/.config/sway/zed-brave-split.sh
bindsym Ctrl+Mod1+Mod4+a exec $HOME/.config/sway/alacritty-brave-split.sh
bindsym Ctrl+Mod1+Mod4+t exec $HOME/.config/sway/alacritty-zed-split.sh
bindsym Ctrl+Mod1+Mod4+s exec $HOME/.config/sway/sway-swap-split.sh

# Send a toggle signal to Waybar on Fedora using Ctrl+Alt+Super+Return
bindsym Ctrl+Mod1+Mod4+Return exec killall -q -SIGUSR1 waybar

# Press Mod4 (Super) + c to pop open your searchable clipboard history
bindsym $mod+c exec cliphist list | rofi -dmenu -p "📋 Clipboard" -theme bubblegum | cliphist decode | wl-copy

# Titlebar / Tab bar styling (starts collapsed/hidden in tabbed layout)
#titlebar_border_thickness 0
#titlebar_padding 0 0
#font pango:monospace 1
#for_window [title=".*"] title_format ""
#exec_always "touch /tmp/sway_tabbars_hidden"

# Automatically format SpeedCrunch as a right-side sidebar whenever it spawns
for_window [app_id="org.speedcrunch.SpeedCrunch"] floating enable, resize set width 40 ppt height 90 ppt, move position 60 ppt 5 ppt

hide_edge_borders smart
default_border none
# Bubblegum Theme Palette (from zed/themes/bubblegum/bubblegum+.json)
# Class                  border    backgr.   text      indicator child_border
client.focused          "#D7AFD7" "#3A3A3A" "#ffffff" "#87D7FF"   "#D7AFD7"
client.focused_inactive "#454545" "#2A2A2a" "#A7A7A7" "#303030"   "#222222"
client.unfocused        "#303030" "#222222" "#808080" "#222222"   "#222222"
client.urgent           "#D78787" "#402020" "#ffffff" "#D78787"   "#D78787"
client.background       "#303030"
titlebar_separator disable
bindsym $mod+Shift+x exec hyprpicker
bindsym $mod+Shift+t exec ~/.config/sway/toggle-titlebars.sh

# ==============================================================================
# Key bindings (ported from Fedora's stock /etc/sway/config, since these are
# core bindings and not part of the config.d drop-ins included below)
# ==============================================================================
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number $ws1
    bindsym $mod+2 workspace number $ws2
    bindsym $mod+3 workspace number $ws3
    bindsym $mod+4 workspace number $ws4
    bindsym $mod+5 workspace number $ws5
    bindsym $mod+6 workspace number $ws6
    bindsym $mod+7 workspace number $ws7
    bindsym $mod+8 workspace number $ws8
    bindsym $mod+9 workspace number $ws9
    bindsym $mod+0 workspace number $ws10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number $ws1
    bindsym $mod+Shift+2 move container to workspace number $ws2
    bindsym $mod+Shift+3 move container to workspace number $ws3
    bindsym $mod+Shift+4 move container to workspace number $ws4
    bindsym $mod+Shift+5 move container to workspace number $ws5
    bindsym $mod+Shift+6 move container to workspace number $ws6
    bindsym $mod+Shift+7 move container to workspace number $ws7
    bindsym $mod+Shift+8 move container to workspace number $ws8
    bindsym $mod+Shift+9 move container to workspace number $ws9
    bindsym $mod+Shift+0 move container to workspace number $ws10
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Toggle the tab/title bar on the focused window (cycles
    # normal -> pixel -> none, i.e. titlebar shown -> thin border -> hidden)
    bindsym $mod+t exec ~/.config/sway/toggle_tab_split.sh

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
