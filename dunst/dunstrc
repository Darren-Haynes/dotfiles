[global]
    # Colors live in dunstrc.d/10-colors.conf, which toggle-theme.sh
    # points at colors-dark.conf or colors-light.conf.

    follow = mouse
    origin = top-right
    offset = (20, 20)
    width = (300, 500)
    height = (0, 300)
    notification_limit = 5
    gap_size = 8

    padding = 14
    horizontal_padding = 16
    frame_width = 2
    corner_radius = 12
    separator_height = 0

    font = monospace 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end
    show_indicators = no

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    enable_recursive_icon_lookup = true

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 5

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    timeout = 0
