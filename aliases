# LISTING
alias l='ls -lA'
alias lsfonts='ls /usr/share/fonts/'

# NAVIGATING
alias cdd="cd ~/Downloads"
alias cdot="cd ~/Dotfiles"
alias cdp="cd ~/Projects"
alias cdm="cd ~/Music"
alias cdbash="cd ~/Dotfiles/bash-scripts"
alias cdyazi="cd ~/Dotfiles/yazi"
alias cdwez="cd ~/Dotfiles/wezterm"
alias cdzed="cd ~/Dotfiles/zed"
alias cdwall="cd ~/Pictures/Wallpaper"

# lSD
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'

# PYTHON
alias idarren="ipython --profile=darren"
alias ptest="pytest -q --cov --cov-report=term-missing"
alias jf="python main.py"

# IMAGES
alias r90="convert -rotate 90 " # then 'from.jpg' to 'to.jpg'
alias r180="convert -rotate 180 " # then 'from.jpg' to 'to.jpg'

# GIT / VERSION CONTROL
alias ga='git add --all .'
alias gca='git commit --all'
alias gd='git diff '
alias gc="git commit -m "
alias gst='git status'
alias gg='git log --all --graph'
alias parent="git log --pretty=format:'%D' HEAD^ | grep 'origin/' | head -n1 | sed 's@origin/@@' | sed 's@,.*@@'"
alias root='cd "$(git rev-parse --show-toplevel || echo .)"'

# GIT / PUSH
alias pushm='git push origin main'
alias pushmast='git push origin master'
alias pusht='git push origin testing'
alias pushf='git push origin front-end'

# GIT / PULL
alias pullm='git pull origin main'
alias pullmast='git pull origin master'
alias pullt='git pull origin testing'
alias pullf='git pull origin front-end'

# GIT / SWITCH & CHECKOUT
alias gomain='git switch main'
alias gomast='git switch master'
alias got='git switch testing'
alias gof='git switch front-end'

# GIT / DIFF
alias gd="git diff | delta --side-by-side"
alias cgd="clear; git diff | delta --side-by-side"

# NODE / NPM / NPX
alias ns='npm run start'
alias play='npx playwright test'
alias e2e='npm run test:e2e'
alias coverage='npm run test:coverage'

# DOTNET
alias csc='dotnet $(find /usr/local/share/dotnet/sdk -name "csc.dll" | sort | tail -n1)'
alias dr="dotnet run"
alias db="dotnet build"
alias dt="dotnet test"

# LINUX SHORTCUTS
alias ag='alias | grep '
alias c='clear'
alias caps='setxkbmap -option caps:escape'
alias fontlist="fc-list : family | sort" # works on linux and macos
alias hg='history | grep '
alias ht='history | tail '
alias now="date '+%R'"
alias rmsymlinks="rm -- *(@)"

# COPY
alias copy='xsel --clipboard < '

# SOURCING
alias soa='source ~/Dotfiles/aliases'
alias sob='source ~/.bashrc'
alias soz='source ~/.zshrc'

# MACOS
alias icloud="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/"
alias spanish="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/Spanish"
alias spanish-study="nvim ~/Library/Mobile\ Documents/com\~apple\~CloudDocs/Spanish/AI-Book/Spanish-Book-AI*"

# NETWORKING
alias myip='curl ifconfig.me'

# MUSIC
alias music='mpv --shuffle ~/Music/MyMusic'
alias jazz='mpv --shuffle ~/Music/MyMusic/Jazz'
alias classic='mpv --shuffle ~/Music/MyMusic/Classical'
alias classical='mpv --shuffle ~/Music/MyMusic/Classical/Classical'
alias baroque='mpv --shuffle ~/Music/MyMusic/Classical/Baroque'
alias romantic='mpv --shuffle ~/Music/MyMusic/Classical/Romantic'
alias reggae='mpv --shuffle ~/Music/MyMusic/Reggae'
alias easy='mpv --shuffle ~/Music/MyMusic/Easy'

# THEMEING
alias theme="~/Dotfiles/bash-scripts/theme-switcher.zsh"
alias random-theme='~/Dotfiles/bash-scripts/theme-rotator.zsh'
alias theme-rotator='~/Dotfiles/bash-scripts/theme-rotator-loop.zsh'
